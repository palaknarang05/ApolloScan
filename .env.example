# Copy this to .env.local and fill in your values.
# .env.local is gitignored — never commit real tokens.

# URL of the running Spring Boot backend
VITE_BACKEND_URL=http://localhost:5555

# Optional: pre-fill the scan modal (useful during development)
VITE_REPO_URL=https://github.com/your-org/your-repo
VITE_GITHUB_TOKEN=ghp_your_token_here
